# Parliament environment variables
#
# Copy this file to `.env` and uncomment / fill the values you need. None of
# these are required for the default local-first config (which talks to a
# local oMLX instance at http://localhost:8080/v1). Add only what you need.

# --- Provider selection -----------------------------------------------------
# Override the default provider for ALL neurotypes. Per-neurotype providers
# (set via `provider = "..."` under `[neurotypes.X]` in parliament.toml) take
# precedence over this. Valid: ollama | lm_studio | omlx | openrouter
# PARLIAMENT_PROVIDER=ollama

# --- oMLX (local) -----------------------------------------------------------
# OMLX_BASE_URL=http://localhost:8080/v1
# OMLX_API_KEY=12345678

# --- OpenRouter (paid hosted-model provider) --------------------------------
# Opt-in per neurotype via `provider = "openrouter"` in parliament.toml.
# Required when ANY neurotype routes through OpenRouter; the factory throws
# at startup if the key is missing.
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional attribution headers — show Parliament on OpenRouter's app
# leaderboard. Both are sent verbatim when set.
# OPENROUTER_HTTP_REFERER=https://parliament.local
# OPENROUTER_X_TITLE=Parliament

# --- REST server hardening --------------------------------------------------
# PARLIAMENT_SERVER_HOST=127.0.0.1
# PARLIAMENT_CORS_ORIGINS=http://localhost:*,http://127.0.0.1:*
# PARLIAMENT_RATE_LIMIT_CONCURRENT=1
# PARLIAMENT_RATE_LIMIT_PER_HOUR=10
# PARLIAMENT_API_KEY=
