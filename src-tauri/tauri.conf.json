{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Parliament",
  "version": "0.2.1",
  "identifier": "ai.parliament.desktop",
  "build": {
    "frontendDist": "../packages/ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "cd packages/ui && pnpm dev",
    "beforeBuildCommand": "bash scripts/bundle-sidecar.sh && cd packages/ui && pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Parliament",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "label": "main"
      }
    ],
    "security": {
      "csp": "default-src 'self' http://localhost:3000 http://127.0.0.1:3000; connect-src http://localhost:3000 http://127.0.0.1:3000 ws://localhost:* ws://127.0.0.1:*; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "dmg",
    "icon": [
      "icons/128x128.png"
    ],
    "externalBin": [
      "binaries/node"
    ],
    "resources": {
      "resources/server": "server"
    },
    "macOS": {
      "entitlements": null,
      "exceptionDomain": "",
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": null
    }
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
