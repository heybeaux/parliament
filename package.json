{
  "name": "parliament",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b packages/core packages/server packages/cli",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": "eslint"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "esbuild": "^0.28.0",
    "eslint": "^9.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.3",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "*"
      ]
    },
    "overrides": {
      "@heybeaux/lattice-core": "0.1.0"
    },
    "patchedDependencies": {
      "@heybeaux/lattice-core@0.1.0": "patches/@heybeaux__lattice-core@0.1.0.patch"
    }
  },
  "dependencies": {
    "commander": "^14.0.3"
  }
}
