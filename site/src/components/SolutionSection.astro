    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 700;
    margin-bottom: 0.25rem;
  }

  .accent {
    color: var(--accent);
    text-shadow: 0 0 40px var(--accent-glow);
  }

  .section-desc {
    font-size: 1.1rem;
    color: var(--text-muted);
    max-width: 600px;
    margin: 0 auto 3rem;
  }

